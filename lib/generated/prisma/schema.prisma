generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                @id @default(cuid())
  email                  String                @unique
  emailVerified          Boolean               @default(false)
  name                   String?
  image                  String?
  role                   Role                  @default(CREATOR)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  hasCompletedOnboarding Boolean               @default(false) @map("onboardingCompleted")
  banned                 Boolean               @default(false)
  banReason              String?
  twoFactorEnabled       Boolean               @default(false)
  // True for synthetic User rows created by the import script, never by real sign-up
  isImported             Boolean               @default(false)
  accounts               Account[]
  twoFactor              TwoFactor?
  brandProfile           BrandProfile?
  receivedConnections    Connection[]          @relation("ReceivedConnections")
  sentConnections        Connection[]          @relation("SentConnections")
  creatorProfile         CreatorProfile?       @relation("CreatorProfileOwner")
  claimedCreatorProfiles CreatorProfile[]      @relation("ClaimedCreatorProfiles")
  receivedMessages       Message[]             @relation("ReceivedMessages")
  sentMessages           Message[]             @relation("SentMessages")
  notifications          Notification[]
  platformStats          PlatformStats[]
  platformTokens         PlatformToken[]
  sessions               Session[]
  communityMemberships   CommunityListMember[]
  savedCreators          Creator[]
  createdCampaignEvents  CampaignEvent[]       @relation("EventCreatedBy")
  requestedEventUpdates  CampaignEventUpdate[] @relation("EventUpdateRequestedBy")
  reviewedEventUpdates   CampaignEventUpdate[] @relation("EventUpdateReviewedBy")
  receivedInvitations    Invitation[]          @relation("ReceivedInvitations")
  brandDisputes          Dispute[]             @relation("BrandDisputes")
  creatorDisputes        Dispute[]             @relation("CreatorDisputes")
  reporterDisputes       Dispute[]             @relation("ReporterDisputes")
  targetedDisputes       Dispute[]             @relation("TargetedDisputes")
  // ── Claim relations ──────────────────────────────────────────────────────────
  submittedClaims        ProfileClaim[]        @relation("SubmittedClaims")
  reviewedClaims         ProfileClaim[]        @relation("ReviewedClaims")

  @@index([isImported])
}

model BrandProfile {
  id               String          @id @default(cuid())
  userId           String          @unique
  companyName      String
  industry         String?
  website          String?
  brandAccountType String?
  bio              String?
  location         String?
  socialLinks      Json?
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  crmLeads         CRMLead[]
  campaigns        Campaign[]
  communityLists   CommunityList[]
  invitations      Invitation[]
  contracts        Contract[]
}

model CreatorProfile {
  id                 String           @id @default(cuid())
  userId             String           @unique
  bio                String?
  niche              String?
  primaryPlatform    String?
  location           String?
  totalFollowers     Int              @default(0)
  avgEngagementRate  Float            @default(0)
  lastStatsUpdate    DateTime?
  socialLinks        Json?
  followerCount      Int?
  averageEngagement  Float?
  topNiches          String[]         @default([])
  lastSyncedAt       DateTime?
  connectedPlatforms String[]         @default([])
  moderationStatus   ModerationStatus @default(PENDING)
  moderationNote     String?
  moderatedAt        DateTime?
  // ── Provenance / claim fields ─────────────────────────────────────────────
  // REGISTERED = normal sign-up; IMPORTED = synthetic profile from import script
  profileOrigin      ProfileOrigin    @default(REGISTERED)
  // NOT_APPLICABLE for real registered creators; UNCLAIMED/CLAIM_PENDING/CLAIMED for imported
  claimStatus        ClaimStatus      @default(NOT_APPLICABLE)
  // The real Duolync User who claimed this imported profile (future claim flow)
  claimedByUserId    String?          @unique
  claimedAt          DateTime?
  // Original email from the import source row (may be placeholder or real email from CSV)
  importedEmail      String?
  // Timestamp of the import run that created this profile
  importedAt         DateTime?
  // Stable identifier for the import batch/source file (e.g. "csv-v1-2026" or "csv-v2-2026")
  importBatchId      String?
  // ── Relations ──────────────────────────────────────────────────────────────
  applications       Application[]
  contracts          Contract[]
  campaignEvents     CampaignEvent[]
  socialPosts        SocialPost[]
  profileClaims      ProfileClaim[]
  profileAliases     ProfileAlias[]
  user               User             @relation("CreatorProfileOwner", fields: [userId], references: [id], onDelete: Cascade)
  claimedBy          User?            @relation("ClaimedCreatorProfiles", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  // claimedByUserId is covered by @unique above

  @@index([profileOrigin])
  @@index([profileOrigin, claimStatus])
}

model SocialPost {
  id               String         @id @default(cuid())
  creatorProfileId String
  platform         String
  postUrl          String?
  imageUrl         String?
  caption          String?
  likes            Int?
  comments         Int?
  views            Int?
  engagementRate   Float?
  postedAt         DateTime?
  fetchedAt        DateTime       @default(now())
  // ── Provenance ────────────────────────────────────────────────────────────
  dataSource       DataSource     @default(LEGACY_UNKNOWN)
  providerPostId   String? // stable platform post ID for future dedup (metadata only in this task)
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@index([creatorProfileId, platform])
  @@index([creatorProfileId, platform, dataSource])
  @@index([creatorProfileId, platform, providerPostId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id          String  @id @default(cuid())
  secret      String
  backupCodes String
  userId      String  @unique
  verified    Boolean @default(true)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
}

model PlatformToken {
  id             String    @id @default(cuid())
  userId         String
  platform       String
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime?
  scopes         String?
  platformUserId String?
  username       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

model PlatformStats {
  id                String     @id @default(cuid())
  userId            String
  platform          String
  followerCount     Int?
  followingCount    Int?
  postCount         Int?
  engagementRate    Float?
  fetchedAt         DateTime   @default(now())
  raw               Json?
  // ── Provenance ─────────────────────────────────────────────────────────────
  dataSource        DataSource @default(LEGACY_UNKNOWN)
  providerAccountId String? // platform's own stable account ID
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId, platform])
  @@index([userId, platform, dataSource])
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  role      String
  createdAt DateTime @default(now())
}

model Message {
  id         String   @id @default(cuid())
  text       String
  createdAt  DateTime @default(now())
  senderId   String
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([senderId, receiverId])
}

model Campaign {
  id               String           @id @default(cuid())
  brandProfileId   String
  title            String
  description      String
  budget           Float
  status           CampaignStatus   @default(DRAFT)
  imageUrl         String?
  deadline         DateTime?
  requirements     String?
  briefDescription String?
  goal             String?
  dosAndDonts      String?
  platforms        String[]         @default([])
  contentFormats   String[]         @default([])
  minFollowers     Int?
  moderationStatus ModerationStatus @default(PENDING)
  moderationNote   String?
  moderatedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  applications     Application[]
  brand            BrandProfile     @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  contracts        Contract[]
  events           CampaignEvent[]
  invitations      Invitation[]
  disputes         Dispute[]

  @@index([brandProfileId])
  @@index([status])
  @@index([moderationStatus])
}

model CampaignEvent {
  id               String                @id @default(cuid())
  campaignId       String
  creatorProfileId String?
  title            String?
  type             CampaignEventType
  platform         String?
  scheduledAt      DateTime
  status           CampaignEventStatus   @default(SCHEDULED)
  createdById      String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  campaign         Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator          CreatorProfile?       @relation(fields: [creatorProfileId], references: [id], onDelete: SetNull)
  createdBy        User                  @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updates          CampaignEventUpdate[]

  @@index([campaignId])
  @@index([scheduledAt])
  @@index([creatorProfileId])
}

model CampaignEventUpdate {
  id            String            @id @default(cuid())
  eventId       String
  requestedById String
  status        EventUpdateStatus @default(PENDING)
  title         String?
  platform      String?
  scheduledAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  reviewedById  String?
  reviewedAt    DateTime?
  event         CampaignEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requestedBy   User              @relation("EventUpdateRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy    User?             @relation("EventUpdateReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([eventId, status])
  @@index([requestedById])
}

model Contract {
  id               String         @id @default(cuid())
  campaignId       String
  brandProfileId   String
  creatorProfileId String
  status           ContractStatus @default(PENDING)
  totalBudget      Float
  createdAt        DateTime       @default(now())
  campaign         Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator          CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  brand            BrandProfile   @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  milestones       Milestone[]
  tasks            Task[]

  @@index([brandProfileId])
  @@index([creatorProfileId])
  @@index([campaignId])
}

model Milestone {
  id         String          @id @default(cuid())
  contractId String
  title      String
  percentage Float
  amount     Float
  status     MilestoneStatus @default(PENDING)
  dueDate    DateTime?
  contract   Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model CRMLead {
  id             String       @id @default(cuid())
  brandProfileId String
  handle         String
  platform       String
  avatarUrl      String?
  followers      Int          @default(0)
  status         LeadStatus   @default(DISCOVERED)
  notes          String?
  createdAt      DateTime     @default(now())
  brand          BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
}

// ── CRM Creator (saved via Chrome Extension) ─────────────────────────────────

model Creator {
  id             String             @id @default(cuid())
  userId         String
  platform       SocialPlatform
  handle         String
  name           String?
  avatarUrl      String?
  sourceUrl      String?
  followersCount Int?
  postsCount     Int?
  email          String?
  notes          String?
  status         SavedCreatorStatus @default(SAVED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, handle])
  @@index([userId])
  @@index([userId, platform])
  @@index([userId, status])
}

model Task {
  id         String    @id @default(cuid())
  contractId String?
  title      String
  dueDate    DateTime
  status     String    @default("TODO")
  createdAt  DateTime  @default(now())
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model Connection {
  id         String           @id @default(cuid())
  senderId   String
  receiverId String
  status     ConnectionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  receiver   User             @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User             @relation("SentConnections", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
}

model CommunityList {
  id             String                @id @default(cuid())
  brandProfileId String
  name           String
  createdAt      DateTime              @default(now())
  brand          BrandProfile          @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  members        CommunityListMember[]

  @@index([brandProfileId])
}

model CommunityListMember {
  id            String        @id @default(cuid())
  listId        String
  creatorUserId String
  addedAt       DateTime      @default(now())
  list          CommunityList @relation(fields: [listId], references: [id], onDelete: Cascade)
  creator       User          @relation(fields: [creatorUserId], references: [id], onDelete: Cascade)

  @@unique([listId, creatorUserId])
  @@index([listId])
  @@index([creatorUserId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Application {
  id               String            @id @default(cuid())
  campaignId       String
  creatorProfileId String
  coverLetter      String?
  proposedRate     Float
  negotiatedRate   Float?
  contentFormats   String[]          @default([])
  brandNote        String?
  selectedPlatform String?
  status           ApplicationStatus @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator          CreatorProfile    @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@unique([campaignId, creatorProfileId])
  @@index([creatorProfileId])
  @@index([campaignId, status])
}

// ── Data provenance / write-source taxonomy ───────────────────────────────────

enum DataSource {
  OFFICIAL_API // OAuth callback with real platform credentials
  APIFY // Apify actor scrape (apify-sync.ts)
  RAPIDAPI // RapidAPI third-party scraper (stats.ts)
  MANUAL_IMPORT // CSV import pipeline (reserved; does not write PlatformStats yet)
  LEGACY_UNKNOWN // Pre-dates provenance tracking; source unverifiable
}

// ── Imported creator provenance ───────────────────────────────────────────────

enum ProfileOrigin {
  REGISTERED
  IMPORTED
}

enum ClaimStatus {
  NOT_APPLICABLE
  UNCLAIMED
  CLAIM_PENDING
  CLAIMED
}

enum Role {
  BRAND
  CREATOR
  ADMIN
}

enum ContractStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_REVIEW
  APPROVED
  PAID
}

enum LeadStatus {
  DISCOVERED
  NEGOTIATING
  INVITED
  REJECTED
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  THREADS
}

enum SavedCreatorStatus {
  SAVED
  CONTACTED
  IN_PROGRESS
  REJECTED
  ARCHIVED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  PENDING
  ACCEPTED
  IN_PROGRESS
  SUBMITTED
}

enum CampaignEventType {
  POST
  STORY
  MEETING
  DEADLINE
}

enum CampaignEventStatus {
  SCHEDULED
  GOING_LIVE
  QUEUED
  SYNCED
  PENDING
  DONE
}

enum EventUpdateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  CAMPAIGN_UPDATE
  APPLICATION_UPDATE
  MESSAGE
  SYSTEM
}

model Invitation {
  id             String           @id @default(cuid())
  campaignId     String
  brandProfileId String
  creatorUserId  String
  message        String?
  proposedBudget Float?
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  campaign       Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  brand          BrandProfile     @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  creator        User             @relation("ReceivedInvitations", fields: [creatorUserId], references: [id], onDelete: Cascade)

  @@unique([campaignId, creatorUserId])
  @@index([creatorUserId, status])
  @@index([brandProfileId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Dispute Resolution ────────────────────────────────────────────────────────

model Dispute {
  id              String        @id @default(cuid())
  // User-submitted report fields
  reporterId      String?
  targetUserId    String?
  // Legacy admin-assigned fields (kept for backward compat)
  brandId         String?
  creatorId       String?
  // Common fields
  campaignId      String?
  status          DisputeStatus @default(OPEN)
  reason          ReportReason  @default(OTHER)
  description     String
  resolutionNotes String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  // Relations
  reporter        User?         @relation("ReporterDisputes", fields: [reporterId], references: [id], onDelete: SetNull)
  targetUser      User?         @relation("TargetedDisputes", fields: [targetUserId], references: [id], onDelete: SetNull)
  brand           User?         @relation("BrandDisputes", fields: [brandId], references: [id], onDelete: SetNull)
  creator         User?         @relation("CreatorDisputes", fields: [creatorId], references: [id], onDelete: SetNull)
  campaign        Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([reporterId])
  @@index([targetUserId])
  @@index([brandId])
  @@index([creatorId])
  @@index([campaignId])
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum ReportReason {
  SCAM_FRAUD
  INAPPROPRIATE_CONTENT
  UNPROFESSIONAL_BEHAVIOR
  SPAM
  OTHER
}

// ── Profile Claim ─────────────────────────────────────────────────────────────

enum ProfileClaimStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ProfileClaim {
  id               String             @id @default(cuid())
  creatorProfileId String
  requesterUserId  String?
  status           ProfileClaimStatus @default(PENDING)
  evidenceNote     String?
  evidenceEmail    String?
  evidencePlatform String?
  evidenceHandle   String?
  requiresMerge    Boolean            @default(false)
  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?
  requestedAt      DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  creatorProfile   CreatorProfile     @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  requester        User?              @relation("SubmittedClaims", fields: [requesterUserId], references: [id], onDelete: SetNull)
  reviewedBy       User?              @relation("ReviewedClaims", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([creatorProfileId, status])
  @@index([requesterUserId, status])
  @@index([status, requestedAt])
}

// ProfileAlias maps an old placeholder User.id to the current canonical CreatorProfile.
// fromUserId is NOT a FK — it is a plain string so it survives placeholder User deletion.
// creatorProfileId IS a FK with Cascade so stale aliases are cleaned up if the profile is deleted.
model ProfileAlias {
  id               String         @id @default(cuid())
  fromUserId       String         @unique
  creatorProfileId String
  createdAt        DateTime       @default(now())
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
}

// ── Rate limiting ─────────────────────────────────────────────────────────────

model RateLimitEvent {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}
