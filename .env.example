# PostgreSQL connection string (Railway, Supabase, Neon, etc.)
# Railway format: postgresql://postgres:password@host.railway.app:5432/railway
DATABASE_URL="postgresql://user:password@host:5432/duolync"

# Better Auth — generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-here"
BETTER_AUTH_URL="http://localhost:3000"

# Public app URL (used by auth client)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# IMPORTANT: Pick one host everywhere (localhost vs 127.0.0.1). Must match BETTER_AUTH_URL and the URL you open in the browser, or OAuth cookies/state will mismatch.

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS="http://localhost:3000"

# Google Cloud Console (OAuth 2.0 Web client):
# - Authorized JavaScript origins: http://localhost:3000 (prod: https://your-domain.com)
# - Authorized redirect URIs: http://localhost:3000/api/auth/callback/google (prod: https://your-domain.com/api/auth/callback/google)
# BETTER_AUTH_URL should match the origin you use in the browser (same as redirect base).
# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Meta Platforms (Instagram / Facebook Page / Threads)
# Meta App Dashboard: https://developers.facebook.com/apps/
NEXT_PUBLIC_META_APP_ID=""
META_APP_SECRET=""

# Threads — separate Threads App (not the same as Meta)
# Threads App Dashboard: https://developers.facebook.com/apps/ → Threads API
NEXT_PUBLIC_THREADS_APP_ID=""
THREADS_APP_SECRET=""

# TikTok Login Kit v2
# TikTok Developer Portal: https://developers.tiktok.com/
# Add redirect URI: https://your-domain.com/api/auth/callback/tiktok
NEXT_PUBLIC_TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# YouTube Data API v3 (dedicated OAuth credentials — separate from Google login)
# Google Cloud Console: https://console.cloud.google.com/
#   1. Create OAuth 2.0 Client ID (Web application)
#   2. Add authorized redirect URI: https://your-domain.com/api/auth/callback/youtube
#   3. Enable "YouTube Data API v3" in APIs & Services
# NEXT_PUBLIC_YOUTUBE_CLIENT_ID is the same value as YOUTUBE_CLIENT_ID;
# the NEXT_PUBLIC_ prefix makes it available to the browser for the OAuth redirect.
NEXT_PUBLIC_YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# UploadThing — https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=""

# Apify — https://console.apify.com/account/integrations
# Used to sync creator analytics (Instagram / TikTok follower count, engagement rate, niches)
APIFY_API_TOKEN=""
