generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String          @id @default(cuid())
  email                  String          @unique
  emailVerified          Boolean         @default(false)
  name                   String?
  image                  String?
  role                   Role            @default(CREATOR)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  hasCompletedOnboarding Boolean         @default(false) @map("onboardingCompleted")
  banned                 Boolean         @default(false)
  banReason              String?
  accounts               Account[]
  brandProfile           BrandProfile?
  receivedConnections    Connection[]    @relation("ReceivedConnections")
  sentConnections        Connection[]    @relation("SentConnections")
  creatorProfile         CreatorProfile?
  receivedMessages       Message[]       @relation("ReceivedMessages")
  sentMessages           Message[]       @relation("SentMessages")
  notifications          Notification[]
  platformStats          PlatformStats[]
  platformTokens         PlatformToken[]
  sessions               Session[]
  communityMemberships   CommunityListMember[]
  createdCampaignEvents  CampaignEvent[]       @relation("EventCreatedBy")
  requestedEventUpdates  CampaignEventUpdate[] @relation("EventUpdateRequestedBy")
  reviewedEventUpdates   CampaignEventUpdate[] @relation("EventUpdateReviewedBy")
  receivedInvitations    Invitation[]    @relation("ReceivedInvitations")
}

model BrandProfile {
  id               String          @id @default(cuid())
  userId           String          @unique
  companyName      String
  industry         String?
  website          String?
  brandAccountType String?
  bio              String?
  location         String?
  socialLinks      Json?
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  crmLeads         CRMLead[]
  campaigns        Campaign[]
  communityLists   CommunityList[]
  invitations      Invitation[]
  contracts        Contract[]
}

model CreatorProfile {
  id                 String        @id @default(cuid())
  userId             String        @unique
  bio                String?
  niche              String?
  primaryPlatform    String?
  location           String?
  totalFollowers     Int           @default(0)
  avgEngagementRate  Float         @default(0)
  lastStatsUpdate    DateTime?
  socialLinks        Json?
  followerCount      Int?
  averageEngagement  Float?
  topNiches          String[]      @default([])
  lastSyncedAt       DateTime?
  connectedPlatforms String[]      @default([])
  applications       Application[]
  contracts          Contract[]
  campaignEvents     CampaignEvent[]
  socialPosts        SocialPost[]
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialPost {
  id               String         @id @default(cuid())
  creatorProfileId String
  platform         String
  postUrl          String?
  imageUrl         String?
  caption          String?
  likes            Int?
  comments         Int?
  views            Int?
  engagementRate   Float?
  postedAt         DateTime?
  fetchedAt        DateTime       @default(now())
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@index([creatorProfileId, platform])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model PlatformToken {
  id             String    @id @default(cuid())
  userId         String
  platform       String
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime?
  scopes         String?
  platformUserId String?
  username       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

model PlatformStats {
  id             String   @id @default(cuid())
  userId         String
  platform       String
  followerCount  Int?
  followingCount Int?
  postCount      Int?
  engagementRate Float?
  fetchedAt      DateTime @default(now())
  raw            Json?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId, platform])
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  role      String
  createdAt DateTime @default(now())
}

model Message {
  id         String   @id @default(cuid())
  text       String
  createdAt  DateTime @default(now())
  senderId   String
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([senderId, receiverId])
}

model Campaign {
  id             String         @id @default(cuid())
  brandProfileId String
  title          String
  description    String
  budget         Float
  status         CampaignStatus @default(DRAFT)
  imageUrl       String?
  deadline       DateTime?
  requirements      String?
  briefDescription  String?
  goal              String?
  dosAndDonts       String?
  platforms         String[]       @default([])
  contentFormats    String[]       @default([])
  minFollowers      Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  applications   Application[]
  brand          BrandProfile   @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  contracts      Contract[]
  events         CampaignEvent[]
  invitations    Invitation[]

  @@index([brandProfileId])
  @@index([status])
}

model CampaignEvent {
  id                 String              @id @default(cuid())
  campaignId         String
  creatorProfileId   String?
  title              String?
  type               CampaignEventType
  platform           String?
  scheduledAt        DateTime
  status             CampaignEventStatus @default(SCHEDULED)
  createdById        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  campaign           Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator            CreatorProfile?     @relation(fields: [creatorProfileId], references: [id], onDelete: SetNull)
  createdBy          User                @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updates            CampaignEventUpdate[]

  @@index([campaignId])
  @@index([scheduledAt])
  @@index([creatorProfileId])
}

model CampaignEventUpdate {
  id            String            @id @default(cuid())
  eventId       String
  requestedById String
  status        EventUpdateStatus @default(PENDING)
  title         String?
  platform      String?
  scheduledAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  reviewedById  String?
  reviewedAt    DateTime?
  event         CampaignEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requestedBy   User              @relation("EventUpdateRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy    User?             @relation("EventUpdateReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([eventId, status])
  @@index([requestedById])
}

model Contract {
  id               String         @id @default(cuid())
  campaignId       String
  brandProfileId   String
  creatorProfileId String
  status           ContractStatus @default(PENDING)
  totalBudget      Float
  createdAt        DateTime       @default(now())
  campaign         Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator          CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  brand            BrandProfile   @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  milestones       Milestone[]
  tasks            Task[]

  @@index([brandProfileId])
  @@index([creatorProfileId])
  @@index([campaignId])
}

model Milestone {
  id         String          @id @default(cuid())
  contractId String
  title      String
  percentage Float
  amount     Float
  status     MilestoneStatus @default(PENDING)
  dueDate    DateTime?
  contract   Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model CRMLead {
  id             String       @id @default(cuid())
  brandProfileId String
  handle         String
  platform       String
  avatarUrl      String?
  followers      Int          @default(0)
  status         LeadStatus   @default(DISCOVERED)
  notes          String?
  createdAt      DateTime     @default(now())
  brand          BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
}

model Task {
  id         String    @id @default(cuid())
  contractId String?
  title      String
  dueDate    DateTime
  status     String    @default("TODO")
  createdAt  DateTime  @default(now())
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model Connection {
  id         String           @id @default(cuid())
  senderId   String
  receiverId String
  status     ConnectionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  receiver   User             @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User             @relation("SentConnections", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
}

model CommunityList {
  id             String                @id @default(cuid())
  brandProfileId String
  name           String
  createdAt      DateTime              @default(now())
  brand          BrandProfile          @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  members        CommunityListMember[]

  @@index([brandProfileId])
}

model CommunityListMember {
  id            String        @id @default(cuid())
  listId        String
  creatorUserId String
  addedAt       DateTime      @default(now())
  list          CommunityList @relation(fields: [listId], references: [id], onDelete: Cascade)
  creator       User          @relation(fields: [creatorUserId], references: [id], onDelete: Cascade)

  @@unique([listId, creatorUserId])
  @@index([listId])
  @@index([creatorUserId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Application {
  id               String            @id @default(cuid())
  campaignId       String
  creatorProfileId String
  coverLetter      String?
  proposedRate     Float
  negotiatedRate   Float?
  contentFormats   String[]          @default([])
  brandNote        String?
  selectedPlatform String?
  status           ApplicationStatus @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator          CreatorProfile    @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@unique([campaignId, creatorProfileId])
  @@index([creatorProfileId])
  @@index([campaignId, status])
}

enum Role {
  BRAND
  CREATOR
  ADMIN
}

enum ContractStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_REVIEW
  APPROVED
  PAID
}

enum LeadStatus {
  DISCOVERED
  NEGOTIATING
  INVITED
  REJECTED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  PENDING
  ACCEPTED
  IN_PROGRESS
  SUBMITTED
}

enum CampaignEventType {
  POST
  STORY
  MEETING
  DEADLINE
}

enum CampaignEventStatus {
  SCHEDULED
  GOING_LIVE
  QUEUED
  SYNCED
  PENDING
  DONE
}

enum EventUpdateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  CAMPAIGN_UPDATE
  APPLICATION_UPDATE
  MESSAGE
  SYSTEM
}

model Invitation {
  id             String           @id @default(cuid())
  campaignId     String
  brandProfileId String
  creatorUserId  String
  message        String?
  proposedBudget Float?
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  campaign       Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  brand          BrandProfile     @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  creator        User             @relation("ReceivedInvitations", fields: [creatorUserId], references: [id], onDelete: Cascade)

  @@unique([campaignId, creatorUserId])
  @@index([creatorUserId, status])
  @@index([brandProfileId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ── Rate limiting ─────────────────────────────────────────────────────────────

model RateLimitEvent {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}
